rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the target data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Secure the users profile collection
    match /users/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Accounts cannot be arbitrarily deleted without admin intervention
    }

    // Secure the mood tracker logs collection
    match /mood_logs/{logId} {
      // Users can only read, update, or delete logs they created
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can only create logs that are linked to their own uid
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
